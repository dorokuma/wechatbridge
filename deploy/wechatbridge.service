[Unit]
Description=WeChat Bridge Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ExecStart uses %h which resolves to the home directory of the User specified below.
# Make sure the service user has run: pipx install wechatbridge-cli
ExecStart=%h/.local/bin/wechatbridge
EnvironmentFile=-%h/.config/wechatbridge/.env
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5s
# Create a dedicated system user if running under a non-root account
User=wechatbridge

[Install]
WantedBy=multi-user.target
