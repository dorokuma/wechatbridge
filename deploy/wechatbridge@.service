[Unit]
Description=WeChat Bridge Service (instance %i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ExecStart uses %h which resolves to the home directory of the User specified below.
# Make sure the service user has run: pipx install wechatbridge-cli
ExecStart=%h/.local/bin/wechatbridge
# Instance-specific config: ~/.config/wechatbridge/%i.env
# Falls back to ~/.config/wechatbridge/.env
EnvironmentFile=-%h/.config/wechatbridge/%i.env
Environment=WECHATBRIDGE_INSTANCE=%i
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5s
# Cap per-instance RSS so a single busy bot cannot OOM a small host
MemoryAccounting=yes
MemoryMax=300M
# Create a dedicated system user if running under a non-root account
User=wechatbridge

[Install]
WantedBy=multi-user.target
